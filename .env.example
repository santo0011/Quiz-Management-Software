# On the LIVE server, APP_URL MUST be the site's real public HTTPS domain
# (e.g. https://portal.yourdomain.com) — never http://, localhost, or 127.0.0.1.
# It is used to build the Result_PDF_URL sent to Zoho, which Zoho must be able
# to fetch over the public internet. After changing it, run:
#   php artisan config:clear && php artisan config:cache
APP_NAME="Quiz Management"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=quiz
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=YOUR_GMAIL_EMAIL
MAIL_PASSWORD=YOUR_GMAIL_APP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=YOUR_GMAIL_EMAIL
MAIL_FROM_NAME="Quiz Management Software"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

ZOHO_ACCOUNTS_URL=https://accounts.zoho.com.au
ZOHO_API_URL=https://www.zohoapis.com.au
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_OTP_VALIDITY_MINUTES=15
ZOHO_STUDENT_LOGIN_FUNCTION=lms_portal_endpoint_1
ZOHO_RECEIVE_RESULTS_FUNCTION=receive_results_data_from_portal
# Optional override for the Result_PDF_URL host sent to Zoho. Only needed if
# the PDF must be served from a different public HTTPS domain than APP_URL
# (e.g. a CDN/edge domain in front of storage). Leave empty to use APP_URL.
# Must be a full https://... URL with no trailing slash — never localhost,
# 127.0.0.1, or a private/internal IP.
ZOHO_RESULT_PDF_BASE_URL=

VITE_APP_NAME="${APP_NAME}"
